rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Keep in sync with NEXT_PUBLIC_ADMIN_EMAILS (rules cannot read env vars).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['csuyash2506@gmail.com'];
    }

    match /advisories/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.severity in ['info', 'warning', 'closed']
        && request.resource.data.message.keys().hasAll(['en', 'hi', 'mr'])
        && request.resource.data.startsAt is string
        && request.resource.data.endsAt is string
        && request.resource.data.endsAt > request.resource.data.startsAt
        && request.resource.data.createdBy == request.auth.token.email;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
