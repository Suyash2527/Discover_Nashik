# Copy to .env.local and fill in. Never commit .env.local.
GEMINI_API_KEY=
# Sarvam AI — OPTIONAL fallback. Leave blank and voice still works:
# Web Speech stays the primary path. With a key, Sarvam covers the two gaps —
# TTS for languages with no installed voice (mr-IN) and STT for browsers with
# no SpeechRecognition. Server-only: never prefix with NEXT_PUBLIC_.
SARVAM_API_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_ADMIN_EMAILS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Optional tuning (defaults are in lib/gemini.ts and lib/sarvam.ts)
GEMINI_MODEL=
GEMINI_STRONG_MODEL=
GEMINI_SEARCH_MODEL=
GEMINI_TIMEOUT_MS=
GEMINI_COMPLEX_TIMEOUT_MS=
GEMINI_STRONG_WAIT_MS=
GEMINI_SEARCH_WAIT_MS=
SARVAM_BASE_URL=
SARVAM_TIMEOUT_MS=
# scripts/eval-hard.ts only
EVAL_URL=
